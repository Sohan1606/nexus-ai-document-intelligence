# Backend. Copy to "backend/.env". Loaded automatically if python-dotenv is installed.
# No paid keys. Safe defaults already exist if you skip this file.

# Paths are relative to the process working directory (use the backend folder).
NEXUS_DATA_DIR=./data
NEXUS_CORPUS_DIR=./corpus
NEXUS_MAX_UPLOAD_BYTES=15728640
NEXUS_CHUNK_SIZE=700
NEXUS_CHUNK_OVERLAP=120
NEXUS_TOP_K=8
NEXUS_RERANK=lexical

# hash = lexical hashed n-grams (default, no download)
# sbert = optional local MiniLM — pip install sentence-transformers first
NEXUS_EMBEDDING_PROVIDER=hash
# NEXUS_EMBEDDING_PROVIDER=sbert
# NEXUS_EMBEDDING_MODEL=all-MiniLM-L6-v2
NEXUS_EMBEDDING_DIM=384
NEXUS_MIN_EVIDENCE_SCORE=0.08

# Browser origins allowed to call this API (no wildcard in the default).
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional local LLM. If Ollama is not running, answers are extractive readings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
