# Frontend (Vite). Copy to ".env" in this folder (the project root).
# Restart `npm run dev` after changing these — Vite reads them at startup.
#
# demo  = in-browser simulation, no backend required (default)
# local = FastAPI RAG. Empty VITE_API_BASE_URL uses the Vite proxy
#         (/api and /health → http://127.0.0.1:8000).
# If local mode is set and FastAPI is down, the UI falls back to demo.

VITE_API_MODE=demo
VITE_API_BASE_URL=

# Kept for compatibility. Prefer VITE_API_MODE.
VITE_DEMO_MODE=true
